# Copy to .env. Everything but SRV_WORLD has a default. (The SRV_ prefix keeps these names apart from the variables of the machine the command runs on:
# a variable of the shell wins over .env, and Windows already defines PUBLIC.) Changing a value never needs a rebuild: docker compose up -d
# The savegame to host: its name without .sav, imported with `import-save` (docs/DOCKER-SERVER.md).
SRV_WORLD=myworld
SRV_SERVER_NAME=MPFever Server
# TCP port players connect to (forward it on your router for the Internet).
# The host address the game port is published on: 0.0.0.0 (every interface, the default) or 127.0.0.1 (this machine only: players join through Steam, nothing is reachable from the network)
SRV_BIND=0.0.0.0
SRV_PORT=28090
SRV_PASSWORD=
SRV_MAX_PLAYERS=8
# shared (one company for all) or separate (one per player)
SRV_COMPANY_MODE=shared
SRV_START_SPEED=1
# The world waits while nobody is connected and runs as soon as a player joins (true), or always runs (false)
SRV_PAUSE_WHEN_EMPTY=false
# Who may pause and change the speed: the players (true) or only the administrator (false); with SRV_SPEED_VOTE=true the players decide together (more than half within a minute)
SRV_PLAYER_SPEED_CONTROL=true
SRV_SPEED_VOTE=false
# Seconds of warning in the chat before a stop or restart while players are connected (0: none). `docker compose stop` then takes that long, plus the save
SRV_SHUTDOWN_WARNING=60
SRV_AUTOSAVE_MINUTES=10
SRV_BACKUPS=10
# List the server in MPFever's public list
SRV_PUBLIC=false
# The message every player receives in the chat when it joins (one line, 300 characters at most); empty: none
SRV_MOTD=
# Logs on stdout (docker logs): json (one JSON object per line: ts, level, component, msg) or text
SRV_LOG_FORMAT=json
# New MPFever release: notify (announced in the log, never installed: update the image) or off (no check)
SRV_UPDATE_CHECK=notify
# Mods: auto (with a mod.io key from `mods login`, the world's mods are installed or updated at every start) or off
SRV_MODS_SYNC=auto
# The game's and Dock's own logs in the same stream: off, error, warn, info (default while the server is tested) or debug
SRV_GAME_LOG=info
# The administration page: off (default, nothing listens) or on (http://127.0.0.1:8080 on this machine only; the token: mpfever-admin token)
SRV_ADMIN_UI=off
SRV_ADMIN_PORT=8080
# Resource limits. Small world: 12 GB and 1 CPU is the minimum (slow to start); a world of 120 MB needs 16 GB and 2 CPUs.
SRV_MEM_LIMIT=16g
SRV_CPUS=2
# Another image or version (rollback): MPFEVER_IMAGE=ghcr.io/ampynjord/mpfever-server:<version>
#MPFEVER_IMAGE=
