# Copy to .env. Everything but WORLD has a default. Changing a value never needs a rebuild: docker compose up -d
# The savegame to host: its name without .sav, imported with `import-save` (README.md).
WORLD=myworld
SERVER_NAME=MPFever Server
# TCP port players connect to (forward it on your router for the Internet).
PORT=28090
PASSWORD=
MAX_PLAYERS=8
# shared (one company for all) or separate (one per player)
COMPANY_MODE=shared
START_SPEED=1
PAUSE_WHEN_EMPTY=false
AUTOSAVE_MINUTES=10
BACKUPS=10
# List the server in MPFever's public list
PUBLIC=false
MOTD=
# Resource limits. Measured for a small world: about 11 GB of RAM and 0.7 core.
MEM_LIMIT=14g
CPUS=2
# Another image or version (rollback): MPFEVER_IMAGE=ghcr.io/dkdknight/mpfever-server:<version>
#MPFEVER_IMAGE=
