<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MPFeverServerList</AssemblyName>
    <RootNamespace>MPFever.ServerList</RootNamespace>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- (0.7.14) the file's details (Properties > Details), the same publisher and copyright as winhttp.dll (tools/mkres.py): a
         program without them looks unknown to antivirus programs -->
    <Company>dkdknight</Company>
    <Product>MPFever</Product>
    <AssemblyTitle>MPFever server list (the public games of MPFever)</AssemblyTitle>
    <Description>MPFever server list (the public games of MPFever)</Description>
    <Copyright>Copyright (C) 2026 dkdknight and the MPFever contributors. GPL-3.0-or-later</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
</Project>
