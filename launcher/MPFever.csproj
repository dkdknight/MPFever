<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MPFever</AssemblyName>
    <RootNamespace>MPFever</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <!-- a warning stops the build (build.bat, CI): none goes into a release unseen -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <!-- texts of the other languages (French and English are in the code), keyed by the English text -->
    <EmbeddedResource Include="lang.json" LogicalName="lang.json" />
    <!-- (0.7.0) the game options of the feature modules, for the dedicated server's settings window (tools/gen_gameopts.py) -->
    <EmbeddedResource Include="gameopts.json" LogicalName="gameopts.json" />
  </ItemGroup>
</Project>
